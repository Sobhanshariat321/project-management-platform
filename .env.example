# ── Project Management Platform ──
# Copy to .env and fill secrets before running.
# Fresh-clone setup documented in README.md.

# ── Environment ──
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ── Database ──
# Docker Compose default matches POSTGRES_* below.
POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# Prisma connection string — keep in sync with POSTGRES_* above:
#   postgresql://USER:PASSWORD@localhost:5432/DB?schema=public
DATABASE_URL=postgresql://app:app@localhost:5432/appdb?schema=public

# ── Auth ──
# Generate 32+ random chars for production (e.g. `openssl rand -base64 32`)
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars
BCRYPT_ROUNDS=10

# ── Frontend (Vite) ──
# Vite only exposes VITE_* vars to the browser.
VITE_API_BASE=/api
VITE_APP_NAME=Project Management Platform
